# Normalise to LF in the repository.
# Without this, files authored on Windows land as CRLF and `prettier --check`
# fails in Linux CI on a diff nobody made.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

# CSV fixtures encode real-world byte-level quirks — CRLF line endings, a BOM,
# embedded newlines. Normalising them would silently delete what they test.
tests/fixtures/*.csv -text
